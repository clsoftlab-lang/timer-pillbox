#
# 이 파일을 `.env` 로 복사한 뒤 실제 키를 채워 넣으세요.  cp .env.example .env
# .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 포함).
# 키(sk-ant-...)는 서버에서만 사용되며 브라우저/저장소에 노출되지 않습니다.

ANTHROPIC_API_KEY=sk-ant-여기에-실제-키-입력
PORT=8787
ALLOW_ORIGIN=*

# 비용 합리적(cost-first) 설정 — 기본값은 저비용 모델.
# 더 높은 품질이 필요하면 AI_MODEL 을 claude-sonnet-5 또는 claude-opus-5 로 올리세요.
AI_MODEL=claude-haiku-4-5
AI_MAX_TOKENS=700
AI_EFFORT=low
# 비용 가드레일
AI_RATE_LIMIT_PER_MIN=20
AI_MONTHLY_TOKEN_CAP=2000000
